# Data layer: "mongo" uses the shared Atlas database (local and production see
# the same data); "mock" keeps the seeded demo data in process memory only.
DATA_SOURCE=mock
# Mirrors DATA_SOURCE for client bundles, which cannot read server-only env
# vars. Keep the two values in sync (mongo = no demo catalogue in the UI).
# NEXT_PUBLIC_* values are inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_DATA_SOURCE=mock

# MongoDB Atlas connection string (required before DATA_SOURCE=mongo). Use the
# same value locally and in production so both environments share one dataset.
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB=selvarq

# Demo content. Defaults to on for DATA_SOURCE=mock and off for mongo, so a
# production database starts empty. Set to "true" to seed the demo catalogue.
SEED_DEMO_DATA=

# Production access accounts, created when demo data is disabled. The admin
# gets the full studio; the seller gets an approved storefront.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SELLER_NAME=
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
SEED_SELLER_BUSINESS_NAME=
SEED_SELLER_MERCHANT_ID=
SEED_SELLER_CITY=

# Canonical site URL (metadataBase, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary. The cloud name is public; the key and secret stay server-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
